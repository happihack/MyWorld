[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/panels/cemetery_card.gd" id="1_card"]
[ext_resource type="Script" path="res://scripts/ui/widgets/close_button.gd" id="2_close"]

[node name="CemeteryCard" type="PanelContainer"]
script = ExtResource("1_card")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Titles" type="VBoxContainer" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="Title" type="Label" parent="Content/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Someone"
text_overrun_behavior = 3

[node name="Subtitle" type="Label" parent="Content/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Year 1"

[node name="Close" type="Button" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("2_close")

[node name="Separator" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Content/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
